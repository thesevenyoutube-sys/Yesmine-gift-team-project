{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role and organization info",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["admin", "member"] },
        "title": { "type": "string", "maxLength": 128 },
        "avatarUrl": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "name", "role"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Marker document indicating admin privileges",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "email"]
    },
    "Project": {
      "title": "Project",
      "description": "Project containing tasks and Kanban boards",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 1000 },
        "color": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["active", "completed", "archived"] },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "color", "status", "createdBy"]
    },
    "Task": {
      "title": "Task",
      "description": "Kanban board task item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "projectId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "assigneeId": { "type": "string", "maxLength": 128 },
        "assigneeName": { "type": "string", "maxLength": 128 },
        "assigneeEmail": { "type": "string", "maxLength": 256 },
        "dueDate": { "type": "string", "maxLength": 32 },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "status": { "type": "string", "enum": ["todo", "doing", "done"] },
        "clientId": { "type": "string", "maxLength": 128 },
        "clientName": { "type": "string", "maxLength": 128 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "projectId", "title", "assigneeId", "priority", "status", "createdBy"]
    },
    "Client": {
      "title": "Client",
      "description": "CRM client profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "company": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 256 },
        "status": { "type": "string", "enum": ["lead", "active", "closed"] },
        "notes": { "type": "string", "maxLength": 3000 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "ownerName": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "company", "status", "ownerId"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Client invoice with line items, tax and total",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "invoiceNumber": { "type": "string", "maxLength": 64 },
        "clientId": { "type": "string", "maxLength": 128 },
        "clientName": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 32 },
        "dueDate": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["draft", "sent", "paid", "overdue"] },
        "taxPercent": { "type": "number" },
        "discountPercent": { "type": "number" },
        "subtotal": { "type": "number" },
        "total": { "type": "number" },
        "notes": { "type": "string", "maxLength": 2000 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "invoiceNumber", "clientId", "date", "dueDate", "status", "total", "createdBy"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Financial expense record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 256 },
        "amount": { "type": "number" },
        "category": { "type": "string", "maxLength": 64 },
        "date": { "type": "string", "maxLength": 32 },
        "clientId": { "type": "string", "maxLength": 128 },
        "projectId": { "type": "string", "maxLength": 128 },
        "recordedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "description", "amount", "category", "date", "recordedBy"]
    },
    "FileItem": {
      "title": "FileItem",
      "description": "Uploaded file metadata attached to project or client",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "size": { "type": "number" },
        "type": { "type": "string", "maxLength": 128 },
        "folder": { "type": "string", "maxLength": 128 },
        "projectId": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "url": { "type": "string", "maxLength": 2000000 },
        "uploadedBy": { "type": "string", "maxLength": 128 },
        "uploaderName": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "uploadedBy", "folder"]
    },
    "Presentation": {
      "title": "Presentation",
      "description": "Slide decks, PDF presentations, and embedded Canva links",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "maxLength": 64 },
        "type": { "type": "string", "enum": ["pdf", "pptx", "images", "canva"] },
        "fileUrl": { "type": "string", "maxLength": 2000000 },
        "thumbnailUrl": { "type": "string", "maxLength": 2000000 },
        "canvaUrl": { "type": "string", "maxLength": 2000 },
        "version": { "type": "number" },
        "projectId": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "tags": { "type": "string", "maxLength": 500 },
        "uploadedBy": { "type": "string", "maxLength": 128 },
        "uploaderName": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "category", "type", "uploadedBy"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Team chat message in channel or DM",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "channelId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 128 },
        "senderAvatar": { "type": "string", "maxLength": 512 },
        "content": { "type": "string", "maxLength": 5000 },
        "attachmentUrl": { "type": "string", "maxLength": 2000000 },
        "attachmentName": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "channelId", "senderId", "senderName", "createdAt"]
    },
    "ChatChannel": {
      "title": "ChatChannel",
      "description": "Chat channel or direct message thread",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["general", "project", "direct"] },
        "projectId": { "type": "string", "maxLength": 128 },
        "members": { "type": "string", "maxLength": 1000 },
        "lastMessage": { "type": "string", "maxLength": 1000 },
        "lastMessageAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "type"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User in-app notification item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "type": { "type": "string", "enum": ["task", "message", "invoice", "system"] },
        "read": { "type": "boolean" },
        "link": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "message", "read"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Audit trail log of system mutations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 128 },
        "module": { "type": "string", "maxLength": 64 },
        "targetId": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 1000 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "userRole": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "action", "module", "userId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile with role designation"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Admin marker authorization documents"
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Team projects with tasks and Kanban boards"
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Kanban tasks assigned to team members"
    },
    "/clients/{clientId}": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "CRM client contacts owned by team members"
    },
    "/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/Invoice" },
      "description": "Client invoices and billing"
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Recorded operational expenses"
    },
    "/files/{fileId}": {
      "schema": { "$ref": "#/entities/FileItem" },
      "description": "Uploaded files and documents"
    },
    "/presentations/{presentationId}": {
      "schema": { "$ref": "#/entities/Presentation" },
      "description": "Presentations, pitch decks and Canva embeds"
    },
    "/chat_channels/{channelId}": {
      "schema": { "$ref": "#/entities/ChatChannel" },
      "description": "Chat channels and DM rooms"
    },
    "/chat_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Chat messages stream"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User in-app notifications"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Admin audit log events"
    }
  }
}
