rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'agrinova.ponic@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Entity Validators
    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.name is string && data.name.size() <= 128 &&
             (data.role == 'admin' || data.role == 'member');
    }

    function isValidProject(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 128 &&
             data.color is string && data.color.size() <= 32 &&
             (data.status == 'active' || data.status == 'completed' || data.status == 'archived') &&
             data.createdBy is string && data.createdBy.size() <= 128;
    }

    function isValidTask(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.projectId is string && data.projectId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.assigneeId is string && data.assigneeId.size() <= 128 &&
             (data.priority == 'low' || data.priority == 'medium' || data.priority == 'high') &&
             (data.status == 'todo' || data.status == 'doing' || data.status == 'done') &&
             data.createdBy is string && data.createdBy.size() <= 128;
    }

    function isValidClient(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 128 &&
             data.company is string && data.company.size() <= 128 &&
             (data.status == 'lead' || data.status == 'active' || data.status == 'closed') &&
             data.ownerId is string && data.ownerId.size() <= 128;
    }

    function isValidClientNote(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.clientId is string && data.clientId.size() <= 128 &&
             data.content is string && data.content.size() <= 2000 &&
             data.authorId is string && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() <= 128;
    }

    function isValidInvoice(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.invoiceNumber is string && data.invoiceNumber.size() <= 64 &&
             data.clientId is string && data.clientId.size() <= 128 &&
             data.date is string && data.date.size() <= 32 &&
             data.dueDate is string && data.dueDate.size() <= 32 &&
             (data.status == 'draft' || data.status == 'sent' || data.status == 'paid' || data.status == 'overdue') &&
             data.total is number &&
             data.createdBy is string && data.createdBy.size() <= 128;
    }

    function isValidExpense(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.description is string && data.description.size() <= 256 &&
             data.amount is number &&
             data.category is string && data.category.size() <= 64 &&
             data.date is string && data.date.size() <= 32 &&
             data.recordedBy is string && data.recordedBy.size() <= 128;
    }

    function isValidFile(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 256 &&
             data.folder is string && data.folder.size() <= 128 &&
             data.uploadedBy is string && data.uploadedBy.size() <= 128;
    }

    function isValidPresentation(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.category is string && data.category.size() <= 64 &&
             data.uploadedBy is string && data.uploadedBy.size() <= 128;
    }

    function isValidChatMessage(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.channelId is string && data.channelId.size() <= 128 &&
             data.senderId is string && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() <= 128;
    }

    function isValidNotification(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.read is bool;
    }

    function isValidAuditLog(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.action is string && data.action.size() <= 128 &&
             data.module is string && data.module.size() <= 64 &&
             data.userId is string && data.userId.size() <= 128;
    }

    // Test doc
    match /test/{docId} {
      allow read: if true;
    }

    // Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && (
        request.auth.uid == userId || isAdmin()
      );
      allow update: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() || (request.auth.uid == userId && incoming().role == existing().role)
      );
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    // Admins
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && request.auth.token.email == 'agrinova.ponic@gmail.com');
    }

    // Projects
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(projectId) && isValidProject(incoming());
      allow update: if isSignedIn() && isValidId(projectId) && isValidProject(incoming()) && (
        isAdmin() || existing().createdBy == request.auth.uid
      );
      allow delete: if isSignedIn() && (isAdmin() || existing().createdBy == request.auth.uid);
    }

    // Tasks
    match /tasks/{taskId} {
      allow get: if isSignedIn() && (
        isAdmin() || resource.data.assigneeId == request.auth.uid || resource.data.createdBy == request.auth.uid
      );
      allow list: if isSignedIn() && (
        isAdmin() || resource.data.assigneeId == request.auth.uid || resource.data.createdBy == request.auth.uid
      );
      allow create: if isSignedIn() && isValidId(taskId) && isValidTask(incoming()) && (
        isAdmin() || incoming().createdBy == request.auth.uid
      );
      allow update: if isSignedIn() && isValidId(taskId) && isValidTask(incoming()) && (
        isAdmin() || existing().assigneeId == request.auth.uid || existing().createdBy == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        isAdmin() || existing().createdBy == request.auth.uid
      );
    }

    // Clients
    match /clients/{clientId} {
      allow get: if isSignedIn() && (
        isAdmin() || resource.data.ownerId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        isAdmin() || resource.data.ownerId == request.auth.uid
      );
      allow create: if isSignedIn() && isValidId(clientId) && isValidClient(incoming()) && (
        isAdmin() || incoming().ownerId == request.auth.uid
      );
      allow update: if isSignedIn() && isValidId(clientId) && isValidClient(incoming()) && (
        isAdmin() || existing().ownerId == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        isAdmin() || existing().ownerId == request.auth.uid
      );

      match /notes/{noteId} {
        allow read: if isSignedIn() && (
          isAdmin() || get(/databases/$(database)/documents/clients/$(clientId)).data.ownerId == request.auth.uid
        );
        allow create: if isSignedIn() && isValidId(noteId) && isValidClientNote(incoming()) && (
          isAdmin() || get(/databases/$(database)/documents/clients/$(clientId)).data.ownerId == request.auth.uid
        ) && incoming().authorId == request.auth.uid;
        allow update, delete: if isSignedIn() && (
          isAdmin() || resource.data.authorId == request.auth.uid
        );
      }
    }

    // Invoices
    match /invoices/{invoiceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(invoiceId) && isValidInvoice(incoming());
      allow update: if isSignedIn() && isValidId(invoiceId) && isValidInvoice(incoming()) && (
        isAdmin() || existing().createdBy == request.auth.uid
      );
      allow delete: if isSignedIn() && (isAdmin() || existing().createdBy == request.auth.uid);
    }

    // Expenses
    match /expenses/{expenseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(expenseId) && isValidExpense(incoming());
      allow update: if isSignedIn() && isValidId(expenseId) && isValidExpense(incoming()) && (
        isAdmin() || existing().recordedBy == request.auth.uid
      );
      allow delete: if isSignedIn() && (isAdmin() || existing().recordedBy == request.auth.uid);
    }

    // Files
    match /files/{fileId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(fileId) && isValidFile(incoming());
      allow update, delete: if isSignedIn() && isValidId(fileId) && (
        isAdmin() || existing().uploadedBy == request.auth.uid
      );
    }

    // Presentations (Logged in team members can view; admins or uploader can edit/delete)
    match /presentations/{presentationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(presentationId) && isValidPresentation(incoming());
      allow update: if isSignedIn() && isValidId(presentationId) && isValidPresentation(incoming()) && (
        isAdmin() || existing().uploadedBy == request.auth.uid
      );
      allow delete: if isSignedIn() && (isAdmin() || existing().uploadedBy == request.auth.uid);
    }

    // Chat Channels
    match /chat_channels/{channelId} {
      allow read, write: if isSignedIn();
    }

    // Chat Messages
    match /chat_messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(messageId) && isValidChatMessage(incoming()) && incoming().senderId == request.auth.uid;
      allow update, delete: if isSignedIn() && (isAdmin() || resource.data.senderId == request.auth.uid);
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming());
      allow update, delete: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidId(logId) && isValidAuditLog(incoming());
      allow update, delete: if false;
    }
  }
}
